# Copy this file to .env and fill in the values. Never commit .env.

# Gigalogy keys (one pair for Maira and Chorus)
MAIRA_PROJECT_KEY=
MAIRA_API_KEY=
MAIRA_BASE_URL=https://api.recommender.gigalogy.com
CHORUS_BASE_URL=https://api.maira.gigalogy.com/chorus

# Stylemate in Maira. `flask seed` copies these into the shop's database row.
MAIRA_PROFILE_ID=
MAIRA_DATASET_ID=
# A second Maira profile whose model draws pictures (e.g. gpt-image-2). Leave empty to hide image preview.
MAIRA_IMAGE_PROFILE_ID=

# Flask session signing key. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional settings (defaults shown)
# DATABASE_URL=sqlite:///stylemate.db
# SHOP_SLUG=stylemate
# UNANSWERED_SCORE_THRESHOLD=30
# CONTACT_MESSAGES_PER_DAY=5   (per visitor; 0 switches the limit off)
# PREVIEWS_PER_DAY=20
